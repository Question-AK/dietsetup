    { "requires": ["root", "preserved"], "priority": 35, "verdict": "nourishing", "satietyMult": 1.0, "nutritionMult": 1.75 },
    { "requires": ["fruit", "preserved"], "priority": 35, "satietyMult": 1.0, "nutritionMult": 1.25 },
    { "requires": ["meat", "preserved"], "priority": 35, "verdict": "nourishing", "satietyMult": 1.0, "nutritionMult": 1.5 },
    { "requires": ["fish", "preserved"], "priority": 35, "verdict": "nourishing", "satietyMult": 1.0, "nutritionMult": 1.5 },
    { "requires": ["meat", "raw"], "priority": 35, "satietyMult": 0.5, "nutritionMult": 0.15 },
    { "requires": ["grain", "cooked"], "priority": 35, "satietyMult": 1.0, "nutritionMult": 1.33 },
    { "requires": ["fungus"], "priority": 30, "verdict": "nourishing", "satietyMult": 1.0, "nutritionMult": 2.5 },
    { "requires": ["root"], "priority": 30, "satietyMult": 1.0, "nutritionMult": 1.5 },
    { "requires": ["leaf"], "priority": 30, "satietyMult": 0.75, "nutritionMult": 0.75 },
    { "requires": ["fruit"], "priority": 30, "satietyMult": 0.75, "nutritionMult": 0.75 },
    { "requires": ["alcohol"], "priority": 25, "verdict": "nourishing", "satietyMult": 1.5, "nutritionMult": 1.5 },
    { "requires": ["preserved"], "priority": 25, "verdict": "nourishing", "satietyMult": 1.0, "nutritionMult": 1.25 },
    { "requires": ["juice", "liquid"], "priority": 25, "satietyMult": 1.0, "nutritionMult": 1.0 }
  ]
