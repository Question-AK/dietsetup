<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods</OutputPath>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Overridable via -p:DietSetupDeployPath=... . Defaults to the Mods junction itself, not its
       target, so deploy follows whichever profile the junction points at without this file
       naming it. -->
  <PropertyGroup>
    <DietSetupDeployPath Condition="'$(DietSetupDeployPath)' == ''">$(VINTAGE_STORY_DATA)\Mods\dietsetup</DietSetupDeployPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VINTAGE_STORY)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Full source identity; unknown Git state is conservative (dirty). -->
  <Target Name="GenerateGitInfo" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\SourceIdentity.ps1&quot; -OutputFile &quot;$(MSBuildProjectDirectory)\$(IntermediateOutputPath)GitInfo.g.cs&quot;" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)GitInfo.g.cs" /></ItemGroup>
  </Target>

  <!-- Explicit opt-in only: -p:DietSetupDeploy=true. Ordinary builds never install. -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(DietSetupDeploy)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Package.ps1&quot; -Dll &quot;$(TargetPath)&quot; -Pdb &quot;$(TargetDir)$(TargetName).pdb&quot; -DeployPath &quot;$(DietSetupDeployPath)&quot; -StagingPath &quot;$(MOD_STAGING_PATH)&quot; -Configuration $(Configuration)" ContinueOnError="false" />
  </Target>

</Project>
